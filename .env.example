# ============================================================
# PrepPilot 环境变量模板（只含占位键，可直接复制为 .env）
#   cp .env.example .env
# 明文管理：.env 已加入 .gitignore 与 .dockerignore，不进镜像、不进仓库。
# ============================================================

# ---------- 应用 ----------
ENV=dev
DEBUG=true
# 本地 8010；容器/k3d/云端注入 8000
APP_PORT=8010
API_PREFIX=/api

# ---------- 数据库（云端自建 Compose PostgreSQL，asyncpg 直连）----------
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/prepilot

# ---------- Redis（缓存 + Celery result backend）----------
REDIS_URL=redis://<host>:<port>/0
CELERY_RESULT_BACKEND=redis://<host>:<port>/1

# ---------- RabbitMQ（Celery broker）----------
CELERY_BROKER_URL=amqp://<user>:<password>@<host>:<port>//

# ---------- JWT（短期 access + 可吊销 refresh）----------
JWT_SECRET=<change-me>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- 邮件（忘记密码验证码；留空则降级为只写日志）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
DEV_ECHO_CODE=false

# ---------- 种子数据（云端部署是否写入演示账号）----------
SEED_DEMO_DATA=true

# ---------- Milvus（本地 k3d + Helm）----------
MILVUS_HOST=<host>
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=default

# ---------- Langfuse（v2 服务端）----------
LANGFUSE_PUBLIC_KEY=<pk>
LANGFUSE_SECRET_KEY=<sk>
LANGFUSE_HOST=http://localhost:3030

# ---------- 腾讯云 COS（简历原件暂存）----------
COS_REGION=<region>
COS_BUCKET=<bucket>
COS_SECRET_ID=<id>
COS_SECRET_KEY=<key>
COS_DOMAIN=https://<bucket>.cos.<region>.myqcloud.com

# ---------- 云服务器（Ansible 部署目标）----------
CLOUD_PUBLIC_IP=<public-ip>
CLOUD_INTERNAL_IP=<internal-ip>

# ---------- LLM ----------
OPENAI_API_KEY=<sk-xxx>
OPENAI_BASE_URL=<openai-compatible-base-url>
LLM_MODEL=qwen3.8-flash
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120

# ---------- Embedding（向量模型；留空则复用 LLM 的 key / base_url）----------
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1024

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
